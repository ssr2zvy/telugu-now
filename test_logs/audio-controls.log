    .question-keyboard-controls[data-visible='true'] { visibility: visible; pointer-events: auto; transform: translate3d(-50%, 0, 0); transition: transform 240ms cubic-bezier(.22, 1, .36, 1), visibility 0s; }
    .google-telugu-input { position: relative; display: grid; gap: 9px; }
    /* Floats above the text box when earlier lines are scrolled out of view. */
    .question-answer-more { position: absolute; top: -20px; left: 50%; transform: translateX(-50%); color: var(--muted); font-size: 18px; line-height: 1; letter-spacing: 2px; pointer-events: none; }
    /* A plain visible textarea between the audio bar and the keyboard: fixed
       two-line height, centered text, native caret, no border chrome. */
    /* Height is exactly two 30px lines plus padding, so a partly visible third
