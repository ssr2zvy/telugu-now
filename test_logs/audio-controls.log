    html[data-input-modality='keyboard'] .reader-settings:focus-visible svg { opacity: 1; }
    @media (prefers-reduced-motion: reduce) { .appearance-root .observation-screen .reader-settings svg { transition: none; } }
    
    /* Both swipe axes are app gestures; pinch zoom remains native. */
    .observation-screen[data-swipe-navigation='true'] { touch-action: pinch-zoom; }
    .audio-player-bar[data-controls-visible='false'],
    .audio-player-bar[data-controls-visible='false'] * { pointer-events: none !important; }
    .audio-precision-panel[data-visible='false'],
    .audio-precision-panel[data-visible='false'] * { pointer-events: none !important; }
    
    /* The bar is the position anchor. The magnifier is out of layout flow,
       offset from the visible timeline's center, independent of reserved rows. */
    .audio-precision-panel { position: absolute; grid-area: auto; left: 0; right: 0; top: calc(50% + var(--magnifier-bar-gap, 4px)); bottom: auto; margin: 0; }
    .audio-player-bar[data-magnifier-position="above"] .audio-precision-panel { grid-area: auto; top: auto; bottom: calc(50% + var(--magnifier-bar-gap, 4px)); margin: 0; }
    .observation-screen { overflow: hidden; }
    
    .audio-magnifier-track { order: 1; }
    .audio-magnifier-time { order: 2; }
    .audio-player-bar[data-magnifier-position="above"] .audio-magnifier-track { order: 2; }
    .audio-player-bar[data-magnifier-position="above"] .audio-magnifier-time { order: 1; }
    
    /* Stable, user-controlled action anchor: animation never changes layout. */
    .observation-screen[data-text-given-flow='true'] { --question-action-bottom: clamp(var(--question-action-floor), calc(var(--question-action-floor) + var(--question-action-offset, 0px)), calc(100dvh - var(--record-button-size) - 24px)); }
    .audio-player-bar[data-controls-visible='true'] .audio-bookmark-controls-slot[data-visible='true'],
    .audio-player-bar[data-controls-visible='true'] .audio-playback-controls-slot[data-visible='true'] { animation: audio-icons-arrive 180ms ease-out both; }
    @keyframes audio-icons-arrive { from { opacity: 0; translate: 0 -10px; } to { opacity: 1; translate: 0 0; } }
    @media (prefers-reduced-motion: reduce) { .audio-player-bar .audio-bookmark-controls-slot, .audio-player-bar .audio-playback-controls-slot { animation: none !important; } }
    
    /* Preserve the live sentence and its audio anchor during exploration. Only
       paint visibility changes; hidden controls retain their layout dimensions. */
    .observation-screen[data-exploring='true'] > .observation-center > :not(.observation-text),
    .observation-screen[data-exploring='true'] > .observation-center > :not(.observation-text) *,
    .observation-screen[data-exploring='true'] > .grammar-evaluation { visibility: hidden !important; pointer-events: none !important; }
    [data-reader-concealed] { visibility: hidden !important; pointer-events: none !important; user-select: none; -webkit-user-select: none; }
    [data-reader-concealed] * { visibility: hidden !important; }
    .exploration-focus .audio-player-bar { display: none; }
    
    /* Expand the speed editor dismissal target without moving its slider. */
    .audio-speed-popover-editor::before { content: ""; position: absolute; inset: -16px; cursor: pointer; }
    .audio-speed-popover-editor .audio-speed-editor { pointer-events: none; }
    .audio-speed-popover-editor .audio-speed-track, .audio-speed-popover-editor .audio-speed-readout { pointer-events: auto; }
    .audio-speed-readout { position: relative; padding: 0; border: 0; background: transparent; color: inherit; cursor: pointer; }
    
