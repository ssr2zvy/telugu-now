    .audio-playback-option[aria-pressed="true"]:not(.audio-loop-option) { background: radial-gradient(circle, color-mix(in srgb, var(--foreground) 16%, transparent) 0 48%, color-mix(in srgb, var(--foreground) 7%, transparent) 66%, transparent 74%); }
    .audio-scrubber::before, .audio-scrubber-progress, .audio-magnifier-track::before,
    .audio-scrubber-thumb, .audio-scrubber-bookmark, .audio-scrubber-window, .audio-magnifier-bar, .audio-magnifier-playhead, .audio-speed-track::before, .audio-speed-fill, .audio-speed-thumb { background: var(--audio-glass-gradient); box-shadow: inset 0 .5px 0 var(--audio-glass-edge); filter: brightness(calc(var(--control-brightness, .85) * var(--audio-detail-brightness, 1))); }
    .audio-scrubber-window { background: var(--audio-glass-gradient), var(--surface); }
    .audio-magnifier-time, .audio-speed-readout { background: var(--audio-glass-gradient); -webkit-background-clip: text; background-clip: text; color: transparent; filter: brightness(var(--control-brightness, .85)); }
    .question-controls { position: absolute; z-index: 6; left: 50%; bottom: max(14px, env(safe-area-inset-bottom)); width: min(760px, calc(100vw - 2rem)); transform: translateX(-50%); }
    .observation-screen[data-question-mode='audio-given'] .observation-center:has(.audio-player-bar[data-has-audio='true']) { margin-bottom: 0; }
    .observation-screen[data-question-mode='audio-given'] .audio-player-bar { top: 35%; bottom: auto; transform: translate(-50%, -50%); }
    .observation-screen[data-question-mode='audio-given'] .question-controls { top: calc(35% + 50px); bottom: max(0px, env(safe-area-inset-bottom)); width: min(860px, calc(100vw - 2rem)); overflow: hidden; }
    /* The primary bar uses the same anchor in every text-given phase. The action
