    .question-comparison { position: absolute; inset: 0; z-index: 4; display: grid; grid-template-columns: 1fr 1fr; grid-template-areas: 'user correct'; opacity: 0; }
    .question-comparison[data-ready='true'] { opacity: 1; }
    .question-comparison-side { position: relative; isolation: isolate; display: grid; place-items: center; min-width: 0; min-height: 0; padding: clamp(1rem, 4vw, 4rem); overflow: hidden; }
    /* Soft, borderless surfaces separate the two answers without moving content. */
