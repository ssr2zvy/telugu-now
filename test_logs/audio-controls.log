       so they don't read as sitting above the caret's vertical center. */
    .question-answer-editor { display: block; box-sizing: border-box; justify-self: center; width: min(100%, 725px); height: 72px; padding: 2px 18px; border: 0; outline: 0; background: transparent; color: var(--foreground); font-family: 'Noto Sans Telugu', sans-serif; font-size: 25px; line-height: 33px; text-align: center; overflow-y: auto; overscroll-behavior: contain; resize: none; scrollbar-width: none; }
    .question-answer-editor::-webkit-scrollbar { display: none; }
    .question-answer-editor:focus, .question-answer-editor:focus-visible { border: 0; outline: 0; box-shadow: none; }
    .question-keyboard { display: grid; gap: 7px 0; padding: 7px; border: 0; border-radius: 11px; background: var(--keyboard-gradient); color: var(--keyboard-ink); box-shadow: inset 0 1px 0 color-mix(in srgb, var(--keyboard-glow) 30%, transparent), inset 0 0 33px color-mix(in srgb, var(--keyboard-glow) 12%, transparent), 0 9px 27px rgb(0 0 0 / .09); overflow: hidden; }
    .question-keyboard-row { position: relative; display: flex; justify-content: center; gap: 0; }
    .question-keyboard-row button { position: relative; display: grid; grid-template-columns: 1fr; place-items: center; flex: 0 1 58px; min-width: 36px; height: 48px; padding: 3px 8px; border: 0; border-radius: 7px; background: transparent; color: color-mix(in srgb, var(--keyboard-ink) 55%, gray 45%); font: inherit; cursor: pointer; box-shadow: none; }
    @media (hover: hover) and (pointer: fine) {
