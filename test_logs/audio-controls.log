    .reader-settings { position: absolute; z-index: 40; top: max(12px, calc(env(safe-area-inset-top) - 4px)); right: max(16px, calc(env(safe-area-inset-right) - 4px)); width: 44px; height: 44px; display: grid; place-items: center; border: 0; padding: 0; background: transparent; color: var(--corner-control-color); cursor: pointer; }
