    .question-comparison-audio { display: grid; place-items: center; width: 100%; height: 100%; cursor: pointer; }
    .question-comparison .audio-player-bar { position: relative; left: auto; bottom: auto; justify-self: center; align-self: center; width: min(416px, 100%); opacity: 1; pointer-events: auto; transform: none; }
    .question-comparison .audio-player-bar:not(:has(.audio-precision-panel[data-visible='true'])) { grid-template-rows: var(--audio-row-height); }
