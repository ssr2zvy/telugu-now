              textures.push(null);
              continue;
            }
            await waitForIdle();
            if (cancelled) return;
            textures.push(await renderTeluguGradientTexture(
              highlightRun.text, typography.fontFamily, appearance.foreground, gradientEndColor, appearance.gradientBarrier,
