    import { preparedAudioCache, toPlayerTime, toSpeechTime, type AudioLease } from './prepared-audio';
    import { reportClientTelemetry } from '../../api';
    
    export interface AudioPlayerState {
      audioRef: RefObject<HTMLAudioElement | null>;
      playing: boolean;
