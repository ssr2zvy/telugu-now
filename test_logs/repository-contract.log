          data-question-phase={observation?.question?.phase}
          data-audio-motion={audioMotion}
          data-swipe-direction={audioMotionDirection === 1 ? 'right' : 'left'}
          className={
            `app-shell observation-screen ${
              audioControlsVisible
                ? 'controls-visible'
                : ''
            }`
