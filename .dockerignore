# Allow only the files needed to build the application.
**
!.dockerignore
!ci-cd/
!ci-cd/Containerfile
!ci-cd/make-artifacts.sh
!ci-cd/container-scripts/
!ci-cd/container-scripts/entrypoint.sh
!upa/
!upa/package.json
!upa/package-lock.json
!upa/tsconfig.json
!upa/frontend/
!upa/frontend/**
!upa/server/
!upa/server/**
!upa/shared/
!upa/shared/**
!upa/scripts/
!upa/scripts/sync-fonts.mjs
!upa/scripts/write-artifact-versions.mjs
!upa/scripts/generate-telugu-alignments.mjs
!upa/scripts/package-grammar-worker.mjs
!data-transform/
!data-transform/scripts/
!data-transform/scripts/build-grammar/
!data-transform/scripts/build-grammar/**
!data-transform/scripts/parse-core/
!data-transform/scripts/parse-core/**
# The existing typecheck includes test sources.
!upa/tests/
!upa/tests/**
# Never include local state or credentials, even inside allowed directories.
**/node_modules
**/dist
**/data
# Parser dictionaries are versioned source assets, not runtime corpus data.
!data-transform/scripts/parse-core/parser/data/
!data-transform/scripts/parse-core/parser/data/lexicon.json
!data-transform/scripts/parse-core/parser/data/modifier_definitions.json
!data-transform/scripts/parse-core/parser/data/contrast_families.json
# These are application source modules, not runtime corpus data.
!upa/server/src/sources/dummy/data/
!upa/server/src/sources/dummy/data/*.ts
**/test-results
**/playwright-report
**/.control
**/.git
**/env
**/dev-secrets.env
**/.env
**/.env.*
**/*.sqlite
**/*.sqlite-*
**/*.pem
**/*.key
