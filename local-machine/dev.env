export NODE_ENV="${NODE_ENV-development}"
export PORT="${PORT-8080}"
export API_DEV_PORT="${API_DEV_PORT-8787}"
export PROFILE_CODES="${PROFILE_CODES-001}"

export DATA_DIRECTORY="${DATA_DIRECTORY-$REPO_DIR/local-machine/data}"
export DATABASE_PATH="${DATABASE_PATH-$DATA_DIRECTORY/user/users.sqlite}"
export CORPUS_DATABASE_PATH="${CORPUS_DATABASE_PATH-$DATA_DIRECTORY/corpus/corpus.sqlite}"
export CORPUS_AVAILABILITY_PATH="${CORPUS_AVAILABILITY_PATH-$DATA_DIRECTORY/corpus/availability.sqlite}"
export AUDIO_VALIDATION_PATH="${AUDIO_VALIDATION_PATH-${CORPUS_AVAILABILITY_PATH%/*}/audio-validation.sqlite}"
export CORPUS_OBJECTS_PATH="${CORPUS_OBJECTS_PATH-$DATA_DIRECTORY/corpus/objects}"

export CORPUS_BACKEND="${CORPUS_BACKEND-local}"
export CORPUS_AVAILABILITY_WORKER_ENABLED="${CORPUS_AVAILABILITY_WORKER_ENABLED-false}"
export CORPUS_AVAILABILITY_REBUILD_ON_STARTUP="${CORPUS_AVAILABILITY_REBUILD_ON_STARTUP-true}"
export CORPUS_AVAILABILITY_REFRESH_MS="${CORPUS_AVAILABILITY_REFRESH_MS-7200000}"

export MOCK_DELAY_MIN_MS="${MOCK_DELAY_MIN_MS-1000}"
export MOCK_DELAY_MAX_MS="${MOCK_DELAY_MAX_MS-15000}"
export SOURCE1_WEIGHT="${SOURCE1_WEIGHT-1}"
export SOURCE2_WEIGHT="${SOURCE2_WEIGHT-1}"
export SOURCE3_WEIGHT="${SOURCE3_WEIGHT-1}"
export FLEURS_TE_WEIGHT="${FLEURS_TE_WEIGHT-1}"
export SHRUTILIPI_TE_WEIGHT="${SHRUTILIPI_TE_WEIGHT-1}"
export INDICVOICES_TE_WEIGHT="${INDICVOICES_TE_WEIGHT-1}"
export COMPLEXITY_PERCENTILE_TARGET="${COMPLEXITY_PERCENTILE_TARGET-0.5}"
export COMPLEXITY_PERCENTILE_SPREAD="${COMPLEXITY_PERCENTILE_SPREAD-0.25}"
export AUDIO_PLAYBACK_RATE_DEFAULT="${AUDIO_PLAYBACK_RATE_DEFAULT-1}"
export MAX_EXPORT_COUNT="${MAX_EXPORT_COUNT-500}"