PORT=8080
PROFILE_CODES=001
# Paths below are optional; defaults follow DATA_DIRECTORY (repository local-machine/data/).
# Set an absolute path for an externally mounted persistent volume.
# DATA_DIRECTORY=/mnt/telugu-data
# DATABASE_PATH=/mnt/telugu-data/user/users.sqlite
# CORPUS_DATABASE_PATH=/mnt/telugu-data/corpus/corpus.sqlite
# CORPUS_AVAILABILITY_PATH=/mnt/telugu-data/corpus/availability.sqlite
# CORPUS_OBJECTS_PATH=/mnt/telugu-data/corpus/objects
CORPUS_BACKEND=local
# Both backends: reuse availability.sqlite by default; fail if missing/incompatible.
CORPUS_AVAILABILITY_REBUILD_ON_STARTUP=false
# Tigris only: force a fresh corpus.sqlite download even if a local copy exists.
CORPUS_CATALOG_FORCE_REDOWNLOAD=false
CORPUS_OBJECTS_PREFIX=corpus/objects/
# For CORPUS_BACKEND=tigris, supply a bucket, endpoint and standard AWS credentials.
# BUCKET_NAME=your-corpus-bucket
# AWS_ENDPOINT_URL_S3=https://fly.storage.tigris.dev
AWS_REGION=auto
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY belong in deployment secrets, not Git.
# Image generation/search: set lowercase pollinations_api_key and serper_api_key through deployment secrets.
# Local secrets belong in the Git-ignored local-machine/dev-secrets.env file.
# The dev controller sources it as Bash and exports assignments to child processes.
# The server reads environment variables only, not local credential files.
API_DEV_PORT=8787
MOCK_DELAY_MIN_MS=1000
MOCK_DELAY_MAX_MS=15000
SOURCE1_WEIGHT=1
SOURCE2_WEIGHT=1
SOURCE3_WEIGHT=1
FLEURS_TE_WEIGHT=1
SHRUTILIPI_TE_WEIGHT=1
INDICVOICES_TE_WEIGHT=1
COMPLEXITY_PERCENTILE_TARGET=0.5
COMPLEXITY_PERCENTILE_SPREAD=0.25
AUDIO_PLAYBACK_RATE_DEFAULT=1
MAX_EXPORT_COUNT=500
